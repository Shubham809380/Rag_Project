# Backend (.env)
DATABASE_URL=postgresql://user:password@localhost:5432/sovereign_ai?sslmode=disable
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
JWT_SECRET=generate-a-strong-random-secret-at-least-32-chars

# Admin
ADMIN_EMAIL=admin@example.com

# === LOCAL DEVELOPMENT ===
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
NODE_ENV=development

# === PRODUCTION ===
# Same-origin deployment:
#   FRONTEND_URL=https://your-domain.com
#   BACKEND_URL=https://your-backend-domain.com
#   GOOGLE_CALLBACK_URL=https://your-backend-domain.com/api/auth/google/callback
#   NODE_ENV=production

# AI & Vector DB
GEMINI_API_KEY=your-gemini-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=your-index-name

# === Advanced AI Agent (optional) ===
# Web research provider. duckduckgo = no key required.
#   serpapi | brave | tavily require WEBSEARCH_API_KEY.
WEBSEARCH_PROVIDER=duckduckgo
WEBSEARCH_API_KEY=
# Free-form search engine override (e.g. duckduckgo_lite)
# WEBSEARCH_ENGINE=duckduckgo

# Voice: STT/TTS. browser = no key required.
#   gemini - use GEMINI_API_KEY above; whisper - requires STT_API_KEY.
STT_PROVIDER=browser
TTS_PROVIDER=browser
STT_API_KEY=
TTS_API_KEY=

# Email for password reset (forgot-password). Nodemailer SMTP.
# If unset, reset emails are logged to console instead of sent.
MAILER_HOST=smtp.example.com
MAILER_PORT=587
MAILER_USER=your-smtp-username
MAILER_PASS=your-smtp-password
MAILER_FROM=no-reply@example.com

# === Sovereign Workbench (network-isolated) ===
# SOVEREIGN_JWT_SECRET=generate-a-strong-random-secret-at-least-32-chars
#   REQUIRED for the sovereign domain. Never reuse the classic JWT_SECRET value.
#   In production the server REFUSES to start when it is missing (no fallback to
#   JWT_SECRET), shorter than 32 chars, or set to any known development
#   placeholder. In development the classic JWT_SECRET is tolerated only as a
#   convenience fallback.
# SOVEREIGN_MODE=local               # local (default, network-isolated) | online
# SOVEREIGN_STORAGE=sqlite          # sqlite (default, local domain) | postgres
# SOVEREIGN_HW_PROFILE=small        # small | mid | large  (selects model slots)
# SOVEREIGN_MODEL_REASONING=qwen3:8b  # optional per-slot overrides for constrained hardware
# SOVEREIGN_MODEL_VISION=qwen3-vl:8b
# SOVEREIGN_MODEL_CODING=qwen3:8b
# SOVEREIGN_MODEL_EMBED=nomic-embed-text
# SOVEREIGN_MODEL_ALLOWLIST=        # comma-separated ids; empty = every configured
#                                   # slot allowed. Non-empty = explicit allowlist
#                                   # enforced by the router (models not listed are
#                                   # refused even if reachable).
# LOCAL_GATEWAY_BASE=http://127.0.0.1:11434
# LOCAL_GATEWAY_OPENAI_COMPAT=false  # Ollama = false (native); true only for vLLM/OpenAI-compatible gateways
# LOCAL_GATEWAY_API_KEY=EMPTY        # vLLM: set "token-abc"; Ollama ignores it
# LOCAL_GATEWAY_TIMEOUT_MS=600000   # generous timeout for CPU-only local models
# LOCAL_EMBED_MODEL=nomic-embed-text # preferred local embedding model id
# SOVEREIGN_EGRESS=deny             # deny (network-isolated default) | monitor | off
# SOVEREIGN_SANDBOX_IMAGE=python:3.12-slim
# SOVEREIGN_SANDBOX=auto             # auto | true | false  (Docker sandbox)
# SOVEREIGN_HOST_FALLBACK=false      # true = run code on host Python when Docker is
#                                    # absent (static-guarded + time-boxed, NOT isolated)
# SOVEREIGN_APPROVE_MEDIUM=true     # also gate MEDIUM-risk tasks behind approval
# SOVEREIGN_DEMO_USER_ID=            # set to enable /demo-login (development only)
# SOVEREIGN_DEMO_USER_EMAIL=
# SOVEREIGN_DEMO_USER_ROLE=inspector
# PORT=5000
# RAG + document hardening:
# SOVEREIGN_MIN_RELEVANCE=0         # >0 = retrieval below this hybrid score is
#                                   # reported as INSUFFICIENT VERIFIED EVIDENCE
# SOVEREIGN_AUDIT_RETENTION_DAYS=365 # age after which audit rows are SOFT-pruned
# SOVEREIGN_AUDIT_JSONL=true
# Backup / maintenance (WAL-safe VACUUM INTO; never blocks ingestion):
# SOVEREIGN_BACKUP=true
# SOVEREIGN_BACKUP_DIR=sovereign/backups
# SOVEREIGN_BACKUP_INTERVAL_MS=3600000
# SOVEREIGN_BACKUP_RETENTION=7       # keep the N most recent backup files

# === Frontend (frontend/.env) ===
# Same-origin: frontend + backend on the same domain
# VITE_API_URL=/api
