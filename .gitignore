sovereign/data/*.sqlite
sovereign/data/*.sqlite-*
sovereign/backups/
sovereign/audit/
sovereign/artifacts/
sovereign/uploads/
sovereign/uploads-test/
uploads/
uploads-test/
sovereign/tmp-tests-*/

