{
  "name": "insightrag",
  "version": "1.0.0",
  "description": "InsightRAG - AI Document Analyzer",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "cd frontend && npm install && npm run build",
    "dev": "node server.js",
    "migrate": "node backend/migrate.js",
    "migrate:v2": "node backend/migrate-v2.js",
    "index": "node index.js",
    "seed": "node scripts/demo-seed.js",
    "demo": "node scripts/demo-run.js",
    "demo:flagship": "node scripts/demo-flagship.js",
    "assets": "node scripts/generate-demo-assets.js",
    "excel": "node scripts/demo-excel-analysis.js",
    "eval": "node evaluation/run-eval.js",
    "test": "node evaluation/run-tests.js",
    "test:tools": "node evaluation/tool-smoke.js",
    "test:tools-live": "set TESTS_LIVE_LLM=1&& node evaluation/tool-smoke.js",
    "test:scanned": "node evaluation/scanned-doc-e2e.js",
    "test:security": "node evaluation/security-brief.js",
    "test:egress": "node evaluation/egress-block-evidence.js",
    "test:auth": "node evaluation/auth-suite.js",
    "test:hardening": "node evaluation/hardening-suite.js",
    "test:docker": "node evaluation/docker-integration.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@langchain/community": "^0.2.20",
    "@langchain/google-genai": "^0.0.20",
    "@langchain/openai": "^1.5.5",
    "@napi-rs/canvas": "^0.1.65",
    "@pinecone-database/pinecone": "^7.2.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "he": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "langchain": "^0.2.20",
    "mammoth": "^1.12.0",
    "markdown-it": "^15.0.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0",
    "pptxgenjs": "^4.0.1",
    "sanitize-html": "^2.17.7",
    "xlsx": "^0.18.5"
  }
